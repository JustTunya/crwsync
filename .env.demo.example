# Demo recording accounts — used only by `pnpm demo:seed`.
#
#   cp .env.demo.example .env.demo
#
# .env.demo is gitignored. These accounts exist solely in the local demo
# database; do not reuse real credentials.

# Recording owner — the account the video is shot from.
DEMO_OWNER_EMAIL=mara@northstar.test
DEMO_OWNER_USERNAME=mara
DEMO_OWNER_PASSWORD=
DEMO_OWNER_FIRSTNAME=Mara
DEMO_OWNER_LASTNAME=Ellis

# Second workspace member — the parallel Playwright context in B7 (chat).
DEMO_MEMBER_EMAIL=tobias@northstar.test
DEMO_MEMBER_USERNAME=tobias
DEMO_MEMBER_PASSWORD=
DEMO_MEMBER_FIRSTNAME=Tobias
DEMO_MEMBER_LASTNAME=Reyes

# Invitee for B4. Must NOT be a workspace member: the invite search filters out
# existing members and pending invitees, so an already-joined user is invisible
# in the invite modal and the beat cannot be shot.
DEMO_INVITEE_EMAIL=priya@northstar.test
DEMO_INVITEE_USERNAME=priya
DEMO_INVITEE_PASSWORD=
DEMO_INVITEE_FIRSTNAME=Priya
DEMO_INVITEE_LASTNAME=Nandakumar
