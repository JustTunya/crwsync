{
  "name": "crwsync",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "benchmark:redis": "pnpm --filter @crwsync/backend run benchmark:redis",
    "dev": "turbo run dev",
    "seed": "node apps/backend/prisma/seed.demo.mjs",
    "demo:seed": "node apps/backend/prisma/seed.demo.mjs"
  },
  "keywords": [
    "crwsync",
    "crew",
    "sync",
    "synchronization",
    "teamwork",
    "collaboration",
    "team-management",
    "productivity",
    "workflow",
    "task-management",
    "project-management",
    "real-time",
    "communication",
    "collaborative-tools",
    "team-communication",
    "remote-work",
    "distributed-teams",
    "cloud-sync",
    "file-sync",
    "data-sync"
  ],
  "author": "Tunya Lénárd-Sándor",
  "description": "crwsync is a collaborative tool designed to enhance teamwork and productivity by providing real-time synchronization of tasks, files, and communication across distributed teams. It aims to streamline project management and improve workflow efficiency in remote work environments.",
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.2",
    "@sentry/cli": "^3.8.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "prisma": "^7.10.1",
    "zustand": "^5.0.16"
  }
}
