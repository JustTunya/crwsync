# ==============================================================================
# crwsync Backend Environment Configuration Reference
# ==============================================================================
# Copy this file to .env in apps/backend:
#   cp apps/backend/.env.example apps/backend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# Core & Server Runtime
# ------------------------------------------------------------------------------
# Application environment (development | production | test)
NODE_ENV=development

# HTTP & WebSocket port
PORT=8080

# Base URL of the public web portal (used in email link generation)
APP_URL=http://localhost:3000

# Allowed CORS origins for REST and Socket.IO (comma-separated, no trailing slashes) [REQUIRED]
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Pino HTTP log level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# ------------------------------------------------------------------------------
# PostgreSQL connection string [REQUIRED]
# Local default matches docker-compose.dev.yml:
DATABASE_URL=postgresql://postgres:password@localhost:5432/crwsync?schema=public

# Log Prisma queries to console in non-production mode (true | false)
PRISMA_LOG_QUERY=false

# ------------------------------------------------------------------------------
# Authentication & Session Security
# ------------------------------------------------------------------------------
# Secret key for cookie signing and validation (min 32 random characters) [REQUIRED]
COOKIE_SECRET=replace_with_a_secure_random_cookie_secret_key_32chars

# Cookie domain scope (e.g., localhost in dev, .crwsync.xyz across subdomains in prod)
ACCESS_COOKIE_DOMAIN=localhost
REFRESH_COOKIE_DOMAIN=localhost

# Secret key for signing short-lived JWT access tokens [REQUIRED]
JWT_ACCESS_TOKEN_SECRET=replace_with_a_secure_random_jwt_secret_key_32chars

# Access token expiration in seconds (default: 900 = 15 minutes)
JWT_ACCESS_TOKEN_EXPIRATION=900

# Retention window in days for revoked session purge cron (default: 30)
PURGE_SESSIONS_DAYS=30

# ------------------------------------------------------------------------------
# Redis & BullMQ Queues
# ------------------------------------------------------------------------------
# Redis host for cache, Socket.IO adapter, and BullMQ background queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASS=
REDIS_DB=0
REDIS_KEY_PREFIX=crwsync:

# ------------------------------------------------------------------------------
# Transactional Email (SMTP)
# ------------------------------------------------------------------------------
# SMTP credentials for sending verification, password reset, and invite emails
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@crwsync.example.com
MAIL_PASS=smtp_password_here

# Recipient address for public marketing contact form submissions
ADMIN_MAIL=admin@crwsync.example.com

# ------------------------------------------------------------------------------
# S3 / Object Storage (MinIO locally, Cloudflare R2 / AWS S3 in production)
# ------------------------------------------------------------------------------
# S3 endpoint URL (MinIO local default: http://localhost:9000) [REQUIRED]
STORAGE_ENDPOINT=http://localhost:9000

# S3 bucket name (must exist or will be auto-created on startup) [REQUIRED]
STORAGE_BUCKET=crwsync

# S3 Access Key ID (MinIO local default: minioadmin) [REQUIRED]
STORAGE_ACCESS_KEY=minioadmin

# S3 Secret Access Key (MinIO local default: minioadmin) [REQUIRED]
STORAGE_SECRET_KEY=minioadmin

# S3 Region (e.g. us-east-1 for AWS/MinIO, auto for Cloudflare R2) [REQUIRED]
STORAGE_REGION=us-east-1

# ------------------------------------------------------------------------------
# Observability & Error Tracking (Sentry)
# ------------------------------------------------------------------------------
# Sentry DSN for backend error aggregation and tracing (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
