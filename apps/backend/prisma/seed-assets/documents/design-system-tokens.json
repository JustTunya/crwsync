{
  "$schema": "https://tokens.northstar.design/v1/schema.json",
  "name": "Northstar Design System Tokens",
  "version": "2.4.0",
  "colors": {
    "brand": {
      "primary": "#3B82F6",
      "primary-hover": "#2563EB",
      "primary-foreground": "#FFFFFF",
      "accent": "#6366F1",
      "success": "#10B981",
      "warning": "#F59E0B",
      "error": "#EF4444"
    },
    "surface": {
      "base-100": {
        "light": "#FFFFFF",
        "dark": "#0B0F19"
      },
      "base-200": {
        "light": "#F3F4F6",
        "dark": "#111827"
      },
      "base-300": {
        "light": "#E5E7EB",
        "dark": "#1F2937"
      }
    },
    "kanban": {
      "blue": "var(--label-blue, #3B82F6)",
      "orange": "var(--label-orange, #F97316)",
      "purple": "var(--label-purple, #8B5CF6)",
      "green": "var(--label-green, #10B981)",
      "red": "var(--label-red, #EF4444)",
      "pink": "var(--label-pink, #EC4899)",
      "yellow": "var(--label-yellow, #EAB308)"
    }
  },
  "typography": {
    "fontFamilies": {
      "sans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "JetBrains Mono, 'Fira Code', Menlo, monospace"
    },
    "scale": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem"
    }
  },
  "spacing": {
    "gridUnit": "4px",
    "sidebarCollapsed": "64px",
    "sidebarExpanded": "240px"
  }
}
