{
 "duration": 85.942875,
 "segments": [
  {
   "start": 0.0,
   "end": 3.12,
   "text": "Your team's work is scattered across tons of different tools."
  },
  {
   "start": 4.12,
   "end": 8.66,
   "text": "CrewSync pulls chat, tasks, and schedules into one real-time workspace."
  },
  {
   "start": 9.78,
   "end": 11.12,
   "text": "Signing in takes seconds."
  },
  {
   "start": 11.98,
   "end": 15.74,
   "text": "One secure session carries you straight from the site into your dashboard."
  },
  {
   "start": 16.7,
   "end": 18.22,
   "text": "Set up a workspace instantly."
  },
  {
   "start": 18.98,
   "end": 22.74,
   "text": "Give it a name, and your environment is ready for the entire team."
  },
  {
   "start": 23.92,
   "end": 25.6,
   "text": "Explore your workspace structure."
  },
  {
   "start": 26.4,
   "end": 28.0,
   "text": "Invite teammates by email."
  },
  {
   "start": 28.0,
   "end": 32.2,
   "text": "Assign their roles and get everyone collaborating in moments."
  },
  {
   "start": 33.26,
   "end": 35.84,
   "text": "Get instant visibility with global statistics."
  },
  {
   "start": 36.74,
   "end": 41.18,
   "text": "Track active workload, velocity, and cycle times as your team completes work."
  },
  {
   "start": 42.06,
   "end": 44.76,
   "text": "Create dedicated task boards for your workflows."
  },
  {
   "start": 45.48,
   "end": 51.86,
   "text": "Define custom columns, set priorities, assign deadlines, and track every item as it moves."
  },
  {
   "start": 52.96,
   "end": 54.56,
   "text": "Chat rooms live in the same sidebar."
  },
  {
   "start": 55.36,
   "end": 60.32,
   "text": "Messages, reactions, mentions, and typing indicators all stream live."
  },
  {
   "start": 61.12,
   "end": 63.68,
   "text": "So conversation stays right next to the work."
  },
  {
   "start": 64.74,
   "end": 65.98,
   "text": "Group your work logically."
  },
  {
   "start": 66.64,
   "end": 70.18,
   "text": "Create a project, then drag your board and chat room inside."
  },
  {
   "start": 70.96,
   "end": 73.58,
   "text": "Everything reorders instantly for the whole team."
  },
  {
   "start": 74.22,
   "end": 79.38,
   "text": "Back on your home dashboard, view pinned modules and live metrics all in one place."
  },
  {
   "start": 80.38,
   "end": 82.56,
   "text": "Tasks, chat, and analytics in sync."
  },
  {
   "start": 82.56,
   "end": 85.46,
   "text": "Crew sync, join the crew."
  }
 ],
