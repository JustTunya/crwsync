# ==============================================================================
# crwsync Dashboard Frontend (Authenticated App) Environment Reference
# ==============================================================================
# Copy this file to .env in apps/frontend/dash:
#   cp apps/frontend/dash/.env.example apps/frontend/dash/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API & Web Portal Connectivity
# ------------------------------------------------------------------------------
# Base URL of the NestJS Backend API & Socket.IO server (client + SSR)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Base URL of the public marketing web portal (for unauthenticated auth redirects)
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Observability & Error Tracking (Sentry)
# ------------------------------------------------------------------------------
# Sentry DSN for frontend dashboard error tracking and performance monitoring (optional)
NEXT_PUBLIC_SENTRY_DSN=
