# ==============================================================================
# crwsync Web Portal Frontend (Public Marketing & Auth) Environment Reference
# ==============================================================================
# Copy this file to .env in apps/frontend/web:
#   cp apps/frontend/web/.env.example apps/frontend/web/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API & Dashboard Connectivity
# ------------------------------------------------------------------------------
# Base URL of the NestJS Backend API (client + SSR)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Base URL of the authenticated Dashboard application (for post-auth redirects)
NEXT_PUBLIC_DASH_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Interactive Demo Account Credentials (Optional)
# ------------------------------------------------------------------------------
# Auto-login credentials for the "Try Live Demo" button on the landing page
NEXT_PUBLIC_DEMO_IDENTIFIER=mara
NEXT_PUBLIC_DEMO_PASSWORD=Password123!

# ------------------------------------------------------------------------------
# Observability & Error Tracking (Sentry)
# ------------------------------------------------------------------------------
# Sentry DSN for frontend marketing portal error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Public origin of this portal, used for canonicals, sitemap, and JSON-LD
NEXT_PUBLIC_WEB_URL=https://crwsync.xyz
